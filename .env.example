# Cognitrix is set up in the app: provider keys, web search keys, email
# sending, sign-in apps, the GitHub App, the agents' computers (Docker or Fly),
# push alerts, safety, sharing, limits and timeouts are all under Settings
# (app-wide ones in Settings > Advanced and on each section). They are not
# read from this file or from environment variables.
#
# What is left here is deployment plumbing for servers, needed before the
# app starts or passed between its processes.

JWT_SECRET_KEY=
# Encrypts saved keys, sign-ins, MCP header tokens and voice keys.
# Without it, desktop/dev installs keep a generated key in ~/.cognitrix/secrets.key
# and production derives one from JWT_SECRET_KEY. Set it before rotating the JWT key.
COGNITRIX_SECRETS_KEY=
JWT_ALGORITHM=HS256

# Deployment: set to 'production' to require JWT_SECRET_KEY (no dev fallback).
COGNITRIX_ENV=development
# Comma-separated allowed CORS origins for the web API.
COGNITRIX_CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# --- Async execution / Celery ---
# Broker for task/team runs. docker-compose sets this to the redis service.
# Leave blank to use the local filesystem-broker fallback (auto-spawns a worker).
CELERY_BROKER_URL=
# Optional dedicated Redis URL for cross-process provider/actor concurrency.
# Production task execution fails closed unless this or a Redis Celery URL is set.
TASK_LIMIT_REDIS_URL=

# --- App database (optional) ---
# Defaults to SQLite at ~/.cognitrix/cognitrix.db. Point at Postgres/MySQL/Mongo
# via odbms if you outgrow a shared SQLite volume.
# DB_TYPE=sqlite
# DB_NAME=
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cognitrix",
  "version": "../package.json",
  "identifier": "com.theonlyamos.cognitrix",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "theonlyamos",
    "category": "Productivity",
    "shortDescription": "AI agents on your desktop",
    "longDescription": "Cognitrix runs AI agents, teams and background tasks on your own machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "engine/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only when the macOS build is code-signed (hardened runtime). -->
<plist version="1.0">
<dict>
  <!-- Voice input in the chat box. Without it a signed app can't open the mic. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>

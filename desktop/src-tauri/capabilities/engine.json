{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "engine-pages",
  "description": "The Cognitrix UI, served by the local engine on 127.0.0.1. Only the app's own windows load it, and navigation away from the engine opens in the browser instead.",
  "windows": ["main", "quick"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging"
  ]
}
